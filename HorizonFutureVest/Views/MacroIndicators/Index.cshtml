@model IEnumerable<Application.ViewModels.MacroIndicatorViewModel>
@{
    Layout = "_Layout";
}
<h2>Macroindicadores</h2>
<a class="btn btn-primary mb-2" href="/MacroIndicators/Create">Crear Macroindicador</a>
@if (!Model.Any())
{
    <div class="alert alert-info">No hay macroindicadores registrados.</div>
}
else
{
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Peso</th>
                <th>¿Más alto mejor?</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var macro in Model)
            {
                <tr>
                    <td>@macro.Name</td>
                    <td>@macro.Weight</td>
                    <td>@(macro.IsHigherBetter ? "Sí" : "No")</td>
                    <td>
                        <a class="btn btn-sm btn-warning text-white" href="/MacroIndicators/Edit/@macro.Id">Editar</a>
                        <a class="btn btn-sm btn-danger text-white" href="/MacroIndicators/Delete/@macro.Id">Eliminar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
