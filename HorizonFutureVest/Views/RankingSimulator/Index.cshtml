@model Application.ViewModels.RankingSimulatorViewModel
@{
    Layout = "_Layout";
}
<h2>Simulador de Ranking</h2>
<form method="post">
    <div class="mb-3">
        <label>Año</label>
        <select asp-for="SelectedYear" asp-items="ViewBag.YearOptions" class="form-control"></select>
    </div>
    <h4>Macroindicadores para Simulación</h4>
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Macroindicador</th>
                <th>Peso</th>
            </tr>
        </thead>
        <tbody>
            @for (int i = 0; i < Model.MacroIndicators.Count; i++)
            {
                <tr>
                    <td>@Model.MacroIndicators[i].Name</td>
                    <td>
                        <input asp-for="MacroIndicators[@i].Weight" class="form-control" type="number" step="0.01" min="0" max="1" />
                        <input type="hidden" asp-for="MacroIndicators[@i].MacroIndicatorId" />
                        <input type="hidden" asp-for="MacroIndicators[@i].Name" />
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <button type="submit" class="btn btn-primary">Simular Ranking</button>
</form>
@if (Model.Results != null && Model.Results.Any())
{
    <table class="table table-bordered mt-4">
        <thead>
            <tr>
                <th>País</th>
                <th>Código ISO</th>
                <th>Scoring</th>
                <th>Tasa de Retorno Estimada</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var result in Model.Results)
            {
                <tr>
                    <td>@result.CountryName</td>
                    <td>@result.IsoCode</td>
                    <td>@result.Scoring</td>
                    <td>@result.EstimatedReturnRate %</td>
                </tr>
            }
        </tbody>
    </table>
}
@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger mt-3">
        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
        {
            <div>@error.ErrorMessage</div>
        }
    </div>
}
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
