@model Application.ViewModels.ReturnRateConfigViewModel
@{
    Layout = "_Layout";
}
<h2>Configuración de Tasas de Retorno</h2>
<form method="post">
    <div class="mb-3">
        <label>Tasa mínima estimada</label>
        <input asp-for="MinRate" class="form-control" type="number" step="0.01" />
        <span asp-validation-for="MinRate" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label>Tasa máxima estimada</label>
        <input asp-for="MaxRate" class="form-control" type="number" step="0.01" />
        <span asp-validation-for="MaxRate" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-success">Guardar</button>
    <div asp-validation-summary="ModelOnly" class="alert alert-danger mt-3"></div>
</form>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
