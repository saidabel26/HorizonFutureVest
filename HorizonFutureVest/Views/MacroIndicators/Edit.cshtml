@model Application.ViewModels.MacroIndicatorViewModel
@{
    Layout = "_Layout";
}
<h2>Editar Macroindicador</h2>
<div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
<form method="post">
    <input type="hidden" asp-for="Id" />
    <div class="mb-3">
        <label>Nombre</label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label>Peso</label>
        <input asp-for="Weight" class="form-control" type="number" step="any" />
        <span asp-validation-for="Weight" class="text-danger"></span>
    </div>
    <div class="mb-3 form-check">
        <input asp-for="IsHigherBetter" class="form-check-input" type="checkbox" />
        <label class="form-check-label" for="IsHigherBetter">¿Más alto mejor?</label>
        <span asp-validation-for="IsHigherBetter" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-success">Guardar</button>
    <a href="/MacroIndicators" class="btn btn-secondary text-white">Volver</a>
</form>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
