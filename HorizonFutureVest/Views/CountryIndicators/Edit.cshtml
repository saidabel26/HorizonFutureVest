@model Application.ViewModels.CountryIndicatorViewModel
@{
    Layout = "_Layout";
}
<h2>Editar Indicador por País</h2>
<form method="post">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
    <div class="mb-3">
        <label>Valor</label>
        <input asp-for="Value" class="form-control" type="number" step="any" />
        <span asp-validation-for="Value" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-success">Guardar</button>
    <a href="/CountryIndicators" class="btn btn-secondary text-white">Volver</a>
</form>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
